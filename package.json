		"@nuxt/devtools": "latest",
		"@nuxt/ui": "^2.22.1",
		"@vueuse/core": "^10.11.1",
		"@vueuse/nuxt": "^10.11.1",
		"husky": "^9.1.7",
		"nuxt": "^3.18.0"
	},
	"dependencies": {
		"lint-staged": "12.3.2"
